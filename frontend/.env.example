# Comma-separated hostnames where the SPA runs without sending X-Tenant-Domain (must match API CENTRAL_DOMAINS).
# NEXT_PUBLIC_CENTRAL_DOMAINS=localhost,127.0.0.1

# UI environment label in tenant footer (local | staging | production). Defaults to local on *.localhost.
# NEXT_PUBLIC_APP_ENV=local
# NEXT_PUBLIC_APP_VERSION=v1.0.4

# Recommended production: same hostname for SPA and API (e.g. https://tenant.example.com with /api routed to Laravel)
# so tenancy resolves from Host and X-Tenant-Domain is not used. If the API stays on a separate central hostname,
# keep TOWEROS_ALLOW_TENANT_ON_CENTRAL_HOST enabled only with TLS + Origin checks on the API.
# Use your tenant domain as host so stancl/tenancy resolves the tenant (e.g. http://acme.localhost:8000/api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: when API host is central (localhost), send this tenant UUID so tenant routes resolve (requires TOWEROS_ALLOW_TENANT_ON_CENTRAL_HOST on the API).
# NEXT_PUBLIC_DEFAULT_TENANT_ID=

# Central (landlord) API — no tenant host; use localhost/127.0.0.1 for platform login and tenant provisioning.
NEXT_PUBLIC_CENTRAL_API_BASE_URL=http://localhost:8000/api/v1

# Tenant create / Add env runs DB create + migrations — allow several minutes locally (default 180000 ms).
# NEXT_PUBLIC_PLATFORM_PROVISIONING_TIMEOUT_MS=180000

# Optional: dev SPA port when building tenant login links server-side (omit for default port 80).
# NEXT_PUBLIC_DEV_APP_PORT=80

# Optional: tenant web login link from platform directory ("Tenant login").
# NEXT_PUBLIC_TENANT_LOGIN_URL_TEMPLATE=http://{host}/login
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_ME_PATH=/me
NEXT_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh
NEXT_PUBLIC_AUTH_LOGOUT_PATH=/auth/logout
NEXT_PUBLIC_AUTH_LOGOUT_ALL_PATH=/auth/logout-all
NEXT_PUBLIC_AUTH_SESSIONS_PATH=/auth/sessions
NEXT_PUBLIC_AUTH_MFA_CHALLENGE_PATH=/auth/mfa/challenge
NEXT_PUBLIC_AUTH_MFA_VERIFY_PATH=/auth/mfa/verify
NEXT_PUBLIC_AUTH_MFA_RECOVERY_PATH=/auth/mfa/recovery
NEXT_PUBLIC_AUTH_MFA_ENROLL_START_PATH=/auth/mfa/enroll/start
NEXT_PUBLIC_AUTH_MFA_ENROLL_COMPLETE_PATH=/auth/mfa/enroll/complete
NEXT_PUBLIC_AUTH_MFA_RECOVERY_REGENERATE_PATH=/auth/mfa/recovery-codes/regenerate
NEXT_PUBLIC_AUTH_AZURE_REDIRECT_PATH=/auth/sso/azure/redirect
# Realtime (Soketi / Pusher protocol). Leave disabled unless you run a websocket server.
NEXT_PUBLIC_SOCKET_ENABLED=false
NEXT_PUBLIC_SOCKET_URL=http://localhost:6001
NEXT_PUBLIC_PUSHER_APP_KEY=toweros-local
NEXT_PUBLIC_PUSHER_HOST=127.0.0.1
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_SCHEME=http
# NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1
NEXT_PUBLIC_PROJECT_ONE_DASHBOARD_PATH=/project-one/dashboard

# MapLibre basemap style URL (WGS84 vector/raster style JSON).
# Production: use MapTiler, self-hosted OpenMapTiles, or your NOC tile provider.
# NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# Dev fallback when unset: https://demotiles.maplibre.org/style.json
