# Dependencies
node_modules/

# Local env (never commit secrets)
.env
.env.*
!.env*.example
.env.docker

# Scratch / temp
.tmp-*
*.log
*.sql.bak
Thumbs.db
.DS_Store

# IDE (repo-level; backend has its own)
.idea/
.vscode/
*.swp

# Local archives / one-off drop folders (docs/archives keeps README only)
docs/archives/**
!docs/archives/README.md

# Frontend / backend build artifacts if ever staged from root
frontend/.next/
frontend/out/
backend/vendor/
backend/bootstrap/cache/*.php
