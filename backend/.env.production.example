# =============================================================================
# TowerOS — PRODUCTION (EC2 + RDS MySQL)
# =============================================================================
# Copy to backend/.env on the EC2 host. Never commit real secrets.
#
# Confirmed AWS baseline (1-year subscription):
#   • EC2 t3.large — 2 vCPU, 8 GB RAM, 50 GB root
#   • EBS gp3 — 100 GB (Docker images, logs, temp)
#   • RDS MySQL 8.4 db.t3.medium Multi-AZ — 2 vCPU, 4 GB, 50 GB
#   • S3 Standard — 50 GB + request allowance (tenant files / exports)
#   • CloudFront — static assets + file downloads
#   • Route 53 — DNS / subdomains
#   • CloudWatch — logs, metrics, alarms
#   • AWS Backup — 30-day retention (RDS + EBS)
#
# Gaps you must still provision (not on the slide): Redis (Docker on EC2 or
# ElastiCache), queue worker, Laravel scheduler, TLS (ALB or Nginx).
# Full steps: docs/infrastructure/aws-ec2-rds-production.md
# =============================================================================

APP_NAME=TowerOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Prefer same-hostname SPA+API for tenants (Nginx routes /api → Laravel).
# Platform console uses CENTRAL_DOMAINS (e.g. console.yourdomain.com).
APP_URL=https://app.yourdomain.com
# Trust nginx/ALB so audit IP and HTTPS detection use X-Forwarded-* (not 127.0.0.1).
TRUSTED_PROXIES=*
FRONTEND_APP_URL=https://app.yourdomain.com
TOWEROS_TENANT_APP_URL=https://app.yourdomain.com
TOWEROS_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning
# Structured audit → CloudWatch agent / container stderr
TOWEROS_AUDIT_STRUCTURED_ENABLED=true
TOWEROS_AUDIT_LOG_CHANNEL=audit
LOG_AUDIT_STACK=audit_daily,audit_stderr
LOG_AUDIT_DAYS=365

# --- Amazon RDS MySQL 8.4 (db.t3.medium, Multi-AZ) ---
DB_CONNECTION=central
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
CENTRAL_DB_PORT=3306
DB_PORT=3306
DB_DATABASE=toweros
DB_USERNAME=toweros
DB_PASSWORD=

TENANCY_CENTRAL_CONNECTION=central
CENTRAL_DOMAINS=console.yourdomain.com
TOWEROS_ALLOW_TENANT_ON_CENTRAL_HOST=false
TOWEROS_TENANT_CENTRAL_DOMAIN_HEADER_REQUIRE_HTTPS=true
TOWEROS_TENANT_CENTRAL_DOMAIN_HEADER_REQUIRE_ORIGIN=true

# --- Redis (required) — default: Docker Compose service on the EC2 ---
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis
PERMISSION_CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# If using ElastiCache instead of Docker Redis:
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_PASSWORD=

# --- Amazon S3 (tenant documents, exports, binders) ---
# Prefer EC2 instance role (leave keys empty) over long-lived IAM users.
FILESYSTEM_DISK=s3
TOWEROS_TENANT_FILES_DISK=s3
TOWEROS_TENANT_FILES_MAX_KB=25600
TOWEROS_DOCUMENTS_MAX_KB=51200
TOWEROS_DOCUMENTS_PRESIGNED_UPLOAD=true
TOWEROS_DOCUMENTS_PRESIGNED_TTL_MINUTES=15
TOWEROS_DOCUMENTS_PRESIGNED_MIN_KB=10240
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=toweros-prod-files-ACCOUNT_ID
AWS_USE_PATH_STYLE_ENDPOINT=false
# CloudFront distribution URL for accelerated GET / downloads (optional):
# AWS_URL=https://d111111abcdef8.cloudfront.net

# --- Mail ---
# Prefer microsoft-graph (Entra Mail.Send) or ses on AWS. Avoid smtp.office365.com when Security Defaults block basic AUTH.
MAIL_MAILER=microsoft-graph
TOWEROS_NOTIFICATIONS_MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
# Entra app with application permission Mail.Send + admin consent (directory GUID, not "common"):
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional dedicated mail app:
# MAIL_GRAPH_TENANT_ID=
# MAIL_GRAPH_CLIENT_ID=
# MAIL_GRAPH_CLIENT_SECRET=
# MAIL_GRAPH_SAVE_TO_SENT_ITEMS=false
# Alternate: Amazon SES (IAM ses:SendRawEmail)
# MAIL_MAILER=ses
# TOWEROS_NOTIFICATIONS_MAIL_MAILER=ses

# Realtime (optional at go-live — run Soketi on EC2 or disable)
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=6001
# PUSHER_SCHEME=https

# Project One geocoding (prefer Mapbox in production)
GEOCODING_DRIVER=auto
MAPBOX_ACCESS_TOKEN=
GEOCODING_COUNTRY=ph
# GEOCODING_CONTACT_EMAIL=ops@yourdomain.com

# AI Assistant — database vector store is OK for first go-live on this sizing;
# switch to OpenSearch when knowledge + traffic grow (docs/performance-runbook.md).
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_EMBEDDING_PROVIDER=local
AI_ASSISTANT_VECTOR_STORE=database
# AI_ASSISTANT_VECTOR_STORE=opensearch
# AI_ASSISTANT_OPENSEARCH_ENDPOINT=https://xxxxx.aoss.amazonaws.com
# AI_ASSISTANT_OPENSEARCH_INDEX=toweros-ai-knowledge
# AI_ASSISTANT_LLM_PROVIDER=bedrock
# AI_ASSISTANT_EMBEDDING_PROVIDER=bedrock

# --- Billing ---
TOWEROS_BILLING_SUPPORT_EMAIL=billing@yourdomain.com
TOWEROS_TENANT_DEFAULT_PLAN_TIER=starter
TOWEROS_SUBSCRIPTION_DEFAULT_STATUS=active
TOWEROS_SUBSCRIPTION_TRIAL_DAYS=14
TOWEROS_SUBSCRIPTION_PAST_DUE_GRACE_DAYS=7
TOWEROS_SUBSCRIPTION_ON_TRIAL_EXPIRE=active
TOWEROS_STRIPE_ENABLED=false
# STRIPE_SECRET=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
TOWEROS_BILLING_CURRENCY=USD
TOWEROS_LIST_PRICE_STARTER_USD=0
TOWEROS_LIST_PRICE_PROFESSIONAL_USD=99
TOWEROS_LIST_PRICE_ENTERPRISE_USD=299

# Security
TOWEROS_TENANT_IMPERSONATION_ENABLED=false
TOWEROS_PLATFORM_IMPERSONATION_ENABLED=false
TOWEROS_TENANT_BOOTSTRAP_EXPOSE_PASSWORD_IN_API=false
TOWEROS_TENANT_DEFAULT_MFA_REQUIRED=true
TOWEROS_PLATFORM_MFA_REQUIRED=true
TOWEROS_PLATFORM_SUPER_ADMIN_EMAIL=ops@yourdomain.com
# Set a strong platform password via secret store — do not use local/dev defaults

TOWEROS_TENANT_ENABLED_MODULES=core,team_access,project_one,e_approval,ticketing,procurement_one,finance_one,billings,sites,documents,document_register
TOWEROS_TENANT_DEFAULT_SSO_AUTO_PROVISION=false
TOWEROS_TENANT_DEFAULT_DISABLE_PASSWORD_WHEN_SSO=true
TENANT_SSO_DEFAULT_ROLES=e_approval_requestor,ticketing_contributor

PASSPORT_ACCESS_TOKEN_TTL_HOURS=12
PASSPORT_REFRESH_TOKEN_TTL_DAYS=30
TENANT_ACCESS_TOKEN_TTL_MINUTES=60
TENANT_REFRESH_TOKEN_TTL_DAYS=30
